# Copiá este archivo a backend/.env (o a la raíz como .env) y completá los valores.
# .env está en .gitignore: la clave nunca se commitea.

# Proveedor de datos: seed (datos de prueba) | api_football
DATA_PROVIDER=seed

# Clave de API-Football (dashboard.api-football.com → Account → My Access)
API_FOOTBALL_KEY=

# Opcionales
# DATABASE_URL=sqlite:///./betpractice_api_football.db
# DATABASE_URL=postgresql+psycopg://usuario:clave@localhost/betpractice
# API_FOOTBALL_TIMEZONE=America/Argentina/Buenos_Aires
# API_FOOTBALL_MIN_DAILY_REMAINING=20
# API_FOOTBALL_CACHE_DIR=./.cache/api_football
